{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 245,
          "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
        },
        "version": {
          "type": "string",
          "enum": [
            "16.0.7",
            "17.0.1"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "$ref": "#/definitions/secretName"
            },
            "staging": {
              "$ref": "#/definitions/secretName"
            }
          }
        },
        "configurationSecret": {
          "$ref": "#/definitions/secretName"
        },
        "bootstrapSecret": {
          "$ref": "#/definitions/optionalSecretName"
        },
        "identityProvider": {
          "$ref": "#/definitions/identity"
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^https://[^ @?#]+(/[^ ?#]*)?$"
            },
            "clientId": {
              "$ref": "#/definitions/identity"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "managed": {
              "type": "boolean"
            },
            "acmeServer": {
              "type": "string",
              "pattern": "^https://[^ ]+$"
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string",
              "minLength": 1
            },
            "tlsSecret": {
              "$ref": "#/definitions/optionalSecretName"
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpoint": {
              "$ref": "#/definitions/identity"
            },
            "repository": {
              "$ref": "#/definitions/repository"
            },
            "readerSecret": {
              "$ref": "#/definitions/secretName"
            },
            "writerSecret": {
              "$ref": "#/definitions/secretName"
            },
            "schedule": {
              "type": "string",
              "maxLength": 128
            },
            "timeZone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^ @]+@sha256:[a-f0-9]{64}$"
            },
            "imagePullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests": {
                  "$ref": "#/definitions/resourceList"
                },
                "limits": {
                  "$ref": "#/definitions/resourceList"
                }
              }
            }
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 245,
              "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "exposure": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "$ref": "#/definitions/identity"
        },
        "repository": {
          "$ref": "#/definitions/repository"
        },
        "readerSecret": {
          "$ref": "#/definitions/secretName"
        },
        "writerSecret": {
          "$ref": "#/definitions/secretName"
        }
      }
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "secretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "optionalSecretName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^rest:https://[^/@?#]+(/[^?#]*)?$"
    },
    "oidcBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/definitions/identity"
        },
        "issuer": {
          "type": "string",
          "pattern": "^https://[^ @?#]+(/[^ ?#]*)?$"
        },
        "clientId": {
          "$ref": "#/definitions/identity"
        }
      },
      "required": [
        "provider",
        "issuer"
      ]
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
      }
    }
  }
}
